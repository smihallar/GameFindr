<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameFindr.Pages.GameDetailsPage"
             Title="{Binding Game.Name}">
    <ContentPage.Content>
        <ScrollView Padding="12">
            <VerticalStackLayout Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Image Source="{Binding Game.Image}" Aspect="AspectFill" HeightRequest="200" />
                <Label Text="{Binding Game.Name}" FontAttributes="Bold" FontSize="Large" />
                <Label Text="{Binding Game.Genre}" FontAttributes="Italic" />
                <Label Text="{Binding Game.ShortDescription}" />
                <Label Text="{Binding ErrorMessage}" TextColor="Tomato" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>